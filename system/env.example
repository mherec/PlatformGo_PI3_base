# /etc/platformgo/env  (root:platformgo 640) - secrets live ONLY here, never in git
HTTP_PORT=8080
LOG_LEVEL=INFO
#DEVICE_ID=pg-0001
# Optional panel/API token (empty = open in LAN)
#APP_TOKEN=

# --- external API (https:// and wss:// only) ---
#CLOUD_WS_URL=wss://api.example.com/device/ws
#CLOUD_API_URL=https://api.example.com
# none | api_key | oauth2
#CLOUD_AUTH=oauth2
#CLOUD_API_KEY=
#CLOUD_API_KEY_HEADER=X-API-Key
#CLOUD_TOKEN_URL=https://auth.example.com/oauth/token
#CLOUD_CLIENT_ID=
#CLOUD_CLIENT_SECRET=
#CLOUD_SCOPE=
#CLOUD_AUDIENCE=
# event type prefixes forwarded to the cloud
#CLOUD_FORWARD=gpio.,uart.rx,ble.,audio.done
